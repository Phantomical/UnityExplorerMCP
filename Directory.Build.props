<?xml version="1.0" encoding="UTF-8"?>

<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectRootDir>$(MSBuildThisFileDirectory)</ProjectRootDir>
    </PropertyGroup>

    <!--
        Paths to GameData folders in the dependency set installs.
    -->
    <PropertyGroup>
        <DepSet1>$(ProjectRootDir)deps/installs/depset1/GameData</DepSet1>
    </PropertyGroup>
</Project>
